@page "/activities/create/{TripId:int}"
@rendermode InteractiveServer
@using Won.Shared.Dtos

@inject Won.Web.Services.Activities.ActivityService ActivityService
@inject NavigationManager Navigation

<PageTitle>Create Activity</PageTitle>

<h1 class="title is-2">Create Activity</h1>

<p class="subtitle is-6">
    Add a new activity to your trip.
</p>

<EditForm Model="NewActivity"
          OnValidSubmit="CreateActivity"
          FormName="CreateActivityForm">

    <DataAnnotationsValidator />
    <ValidationSummary />

    <div class="box">

        <div class="field">
            <label class="label">Activity Name</label>
            <InputText class="input" @bind-Value="NewActivity.Name" />
        </div>

        <div class="field">
            <label class="label">Cost</label>
            <InputNumber class="input" @bind-Value="NewActivity.Cost" />
        </div>

        <div class="field">
            <label class="label">Group Size (Min)</label>
            <InputNumber class="input" @bind-Value="NewActivity.MinimumGroupSize" />
        </div>

        <div class="field">
            <label class="label">Group Size (Max)</label>
            <InputNumber class="input" @bind-Value="NewActivity.MaximumGroupSize" />
        </div>

        <div class="field">
            <label class="label">Date & Time</label>
            <InputDate class="input" Type="InputDateType.DateTimeLocal" @bind-Value="NewActivity.ActivityDateTime" />
        </div>

    </div>

    <div class="buttons">
        <button class="button is-primary" type="submit">
            Create Activity
        </button>

        <NavLink href="@($"/trips/{TripId}")" class="button is-light">
            Cancel
        </NavLink>
    </div>

</EditForm>

@code {
    [Parameter]
    public int TripId { get; set; }

    private CreateActivityDto NewActivity = new() 
    {
        StartDate = DateTime.Today,
        EndDate = DateTime.Today
    };

    protected override void OnInitialized()
    {
        NewActivity.TripId = TripId;
    }

    private async Task CreateActivity()
    {
        var created = await ActivityService.CreateActivityAsync(NewActivity);

        if (created is not null)
        {
            Navigation.NavigateTo($"/trips/{TripId}");
        }
    }
}
