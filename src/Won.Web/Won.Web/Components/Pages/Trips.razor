@page "/trips"
@rendermode InteractiveServer
@using Won.Shared.Dtos
@using Won.Web.Components.Trips
@using Won.Web.Services.Trips

@inject TripsService TripsService

<PageTitle>Trips</PageTitle>

<section>
    <h1 class="title is-2">All Trips</h1>

    <p class="subtitle is-6">
        View your planned trips
    </p>

    <div class="is-flex is-justify-content-flex-end mb-4">
        <NavLink class="button is-primary mb-2" href="/trips/create">Add New Trip</NavLink>
    </div>

    @if (_trips is null)
    {
        <p>Loading trips...</p>
    }
    else
    {
        <div class="trip-page-container">
            <div class="columns is-multiline">
                @foreach (var trip in _trips)
                {
                    <div class="column is-half">
                        <TripCard Trip="trip" />
                    </div>
                }
            </div>
        </div>
    }
</section>

@code {
    private List<TripListItemDto>? _trips;

    protected override async Task OnInitializedAsync()
    {
        _trips = await TripsService.GetTripsAsync();
    }
}
