@page "/trips"
@rendermode InteractiveServer
@using Won.Shared.Dtos
@using Won.Web.Components.Trips
@using Won.Web.Services.Trips

@inject FakeTripService TripService
@inject TripsService TripService 

<PageTitle>Trips</PageTitle>

<section class="section">
    <div class="level mb-5">
        <div class="level-left">
            <div>
                <h1 class="title is-1 mb-2">Trips</h1>
                <p class="subtitle is-5 has-text-grey">
                    View and manage your planned trips.
                </p>
            </div>
        </div>

        <div class="level-right">
            <NavLink class="button is-primary" href="/trips/create">
                Create Trip
            </NavLink>
        </div>
    </div>

    <hr class="mb-6" />

    @if (_trips is null)
    {
        <p>Loading trips...</p>
    }
    else
    {
        <div class="columns is-multiline">
            @foreach (var trip in _trips)
            {
                <div class="column is-one-third">
                    <TripCard Trip="trip" />
                </div>
            }
        </div>
    }
</section>

@code {
    private List<TripListItemDto>? _trips;

    protected override async Task OnInitializedAsync()
    {
        _trips = await TripService.GetTripsAsync();
    }
}