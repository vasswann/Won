@page "/trips/{TripId:int}"

@rendermode InteractiveServer

@using Won.Shared.Dtos
@using Won.Web.Components.Activities
@using Won.Web.Services.Locations
@using Won.Web.Services.Trips
@using Won.Web.Services.Weather
@using Won.Web.Services.Activities

@inject TripsService TripService
@inject WeatherService WeatherService
@inject LocationImageService LocationImageService
@inject ActivitySuggestionService ActivitySuggestionService

<PageTitle>Trip Details</PageTitle>

@if (_trip is null)
{
    <article class="message is-warning">
        <div class="message-body">
            Trip not found.
        </div>
    </article>
}
else
{
    <section class="box mb-6">
        <div class="columns is-vcentered is-variable is-8">
            <div class="column is-half">
                @if (!string.IsNullOrWhiteSpace(_locationImage?.ImageUrl))
                {
                    <figure class="image is-16by9">
                        <img class="is-rounded trip-hero-image"
                             src="@_locationImage.ImageUrl"
                             alt="@_trip.Location">
                    </figure>
                }
                else
                {
                    <div class="box has-text-centered">
                        <p class="title is-1">W</p>
                        <p>No image available for this location.</p>
                    </div>
                }
            </div>

            <div class="column is-half">
                <p class="tag is-primary is-light mb-3">
                    Trip destination
                </p>

                <h1 class="title is-1 mb-2">
                    @_trip.Name
                </h1>

                <p class="subtitle is-4 mb-4">
                    @_trip.Location
                </p>

                <p class="is-size-5 has-text-grey-dark">
                    @if (!string.IsNullOrWhiteSpace(_locationImage?.Extract))
                    {
                        @_locationImage.Extract
                    }
                    else
                    {
                        @_trip.Details
                    }
                </p>
            </div>
        </div>
    </section>

    <article class="message is-info">
        <div class="message-header">
            <p>Weather forecast</p>
        </div>

        <div class="message-body">
            @if (!_isWeatherAvailable)
            {
                <p>
                    Weather forecast is not available yet for this trip.
                    Forecast data is only shown when the trip starts within the next 14 days.
                </p>
            }
            else if (_isWeatherLoading)
            {
                <p>Loading weather forecast...</p>
            }
            else if (_weatherForecast.Count == 0)
            {
                <p>Weather forecast could not be found for this location.</p>
            }
            else
            {
                <div class="columns is-multiline">
                    @foreach (var day in _weatherForecast)
                    {
                        <div class="column is-one-quarter">
                            <div class="box has-text-centered">
                                <p class="has-text-weight-semibold">
                                    @day.Date.ToString("dd MMM")
                                </p>

                                <p class="is-size-2">
                                    @day.Icon
                                </p>

                                <p class="has-text-weight-semibold">
                                    @day.Description
                                </p>

                                <p>
                                    @day.MinTemperature°C - @day.MaxTemperature°C
                                </p>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </article>

    <div class="box">
        <h2 class="title is-4 mb-4">Trip details</h2>

        <div class="columns is-multiline">
            <div class="column is-half">
                <p class="mb-2">
                    <span class="has-text-weight-semibold">Dates:</span>
                    @_trip.StartDate.ToString("dd MMM yyyy") - @_trip.EndDate.ToString("dd MMM yyyy")
                </p>

                <p class="mb-2">
                    <span class="has-text-weight-semibold">Budget:</span>
                    @_trip.Budget.ToString("C")
                </p>

                <p class="mb-2">
                    <span class="has-text-weight-semibold">Group size:</span>
                    @_trip.GroupSize
                </p>
            </div>

            <div class="column is-half">
                <p>
                    <span class="has-text-weight-semibold">Details:</span>
                    @_trip.Details
                </p>
            </div>
        </div>

        <hr />

        <div class="buttons">
            <NavLink href="/trips" class="button is-light">
                Back to Trips
            </NavLink>

            <NavLink href="@($"/trips/edit/{_trip.TripId}")" class="button is-info">
                Edit Trip
            </NavLink>

            <button class="button is-danger">
                Delete Trip
            </button>
        </div>
    </div>

    <article class="message is-primary">
        <div class="message-header">
            <p>AI activity suggestions</p>
        </div>

        <div class="message-body">
            <button class="button is-primary mb-4"
                    @onclick="GenerateActivitySuggestionsAsync"
                    disabled="@_isGeneratingSuggestions">
                @if (_isGeneratingSuggestions)
                {
                    <span>Generating suggestions...</span>
                }
                else
                {
                    <span>Suggest activities</span>
                }
            </button>

            @if (_activitySuggestions.Count > 0)
            {
                <div class="columns is-multiline is-align-items-stretch">
                    @foreach (var activity in _activitySuggestions)
                    {
                        <div class="column is-one-third is-flex">
                            <ActivitySuggestionCard Activity="activity" />
                        </div>
                    }
                </div>
            }
        </div>
    </article>
}

@code {
    [Parameter]
    public int TripId { get; set; }

    private TripDto? _trip;
    private List<WeatherForecastDto> _weatherForecast = [];
    private bool _isWeatherAvailable;
    private bool _isWeatherLoading;
    private LocationImageDto? _locationImage;
    private List<ActivitySuggestionDto> _activitySuggestions = [];
    private bool _isGeneratingSuggestions;

    protected override async Task OnInitializedAsync()
    {
        _trip = await TripService.GetTripByIdAsync(TripId);

        if (_trip is null)
        {
            return;
        }

        _locationImage = await LocationImageService.GetLocationImageAsync(_trip.Location);

        if (_locationImage is null)
        {
            return;
        }

        await LoadWeatherAsync();
    }

    private async Task LoadWeatherAsync()
    {
        var today = DateOnly.FromDateTime(DateTime.Today);
        var forecastEnd = today.AddDays(13);

        var tripStart = DateOnly.FromDateTime(_trip!.StartDate);
        var tripEnd = DateOnly.FromDateTime(_trip.EndDate);

        var weatherStart = tripStart > today ? tripStart : today;
        var weatherEnd = tripEnd < forecastEnd ? tripEnd : forecastEnd;

        _isWeatherAvailable = weatherStart <= weatherEnd;

        if (!_isWeatherAvailable)
        {
            return;
        }

        _isWeatherLoading = true;

        _weatherForecast = await WeatherService.GetWeatherForecastAsync(
            _trip.Location,
            weatherStart,
            weatherEnd);

        _isWeatherLoading = false;
    }

    private async Task GenerateActivitySuggestionsAsync()
    {
        if(_trip is null)
        {
            return;
        }

        _isGeneratingSuggestions = true;

        var request = new ActivitySuggestionRequestDto
        {
            Location = _trip.Location,
            StartDate = _trip.StartDate,
            EndDate = _trip.EndDate,
            Budget = _trip.Budget,
            GroupSize = _trip.GroupSize
        };

        var response = await ActivitySuggestionService.GetActivitySuggestionsAsync(request);

        if(response.Success)
        {
            _activitySuggestions = response.Data ?? [];
        }

        _isGeneratingSuggestions = false;
    }
}