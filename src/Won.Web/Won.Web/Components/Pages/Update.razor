@page "/trips/update/{id:int}"
@using Won.Shared.Dtos
@using Won.Web.Services.Trips
@using Won.Web.Services.Notifications

@rendermode InteractiveServer

@inject TripsService TripsService
@inject NavigationManager Navigation
@inject NotificationService NotificationService

<h3>Edit Your Trip</h3>

@if (_isLoading)
{
    <p>Loading trip...</p>
}
else
{
    <TripForm MyTrip="_trip" OnSubmit="@UpdateTrip" />
}

@code {
    [Parameter]
    public int id { get; set; }

    private TripDto _trip = new();
    private bool _isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        var result = await TripsService.GetTripByIdAsync(id);

        if (result != null)
        {
            _trip = result;
        }

        _isLoading = false;
    }

    private async Task UpdateTrip(TripDto trip)
    {
        try
        {
            var updateTrip = new UpdateTripDto
            {
                Name = trip.Name,
                StartDate = trip.StartDate,
                EndDate = trip.EndDate,
                Location = trip.Location,
                Details = trip.Details,
                Budget = trip.Budget,
                GroupSize = trip.GroupSize
            };

            var response = await TripsService.UpdateTripAsync(id, updateTrip);

            if (response.Success)
            {
                NotificationService.ShowSuccess(response.Message);
                Navigation.NavigateTo("/trips");
                return;
            }

            NotificationService.ShowError(response.Message);
        }
        catch
        {
            NotificationService.ShowError(
                "Something went wrong while updating the trip.");
        }
    }
}