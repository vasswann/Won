@page "/login"
@rendermode InteractiveServer
@inject HttpClient Http
@using Won.Shared.Dtos
@using System.Net.Http.Json
@using Won.Web.Components.Layout
@using System.ComponentModel.DataAnnotations

@layout AuthLayout

<div class="has-text-centered mb-5">
    <div class="is-inline-flex is-align-items-center is-justify-content-center
                has-background-dark has-text-white
                p-4 mb-4"
         style="border-radius: 1rem;">
        <span class="title is-2 has-text-white m-0">W</span>
    </div>
    <h1 class="title is-3">Login</h1>
</div>

<EditForm Model="_model" 
    OnValidSubmit="HandleLoginAsync"
    FormName="LoginForm">
    <DataAnnotationsValidator />

    <div class="field">
        <label class="label">Email</label>
        <div class="control">
            <InputText class="input"
                       type="email"
                       placeholder="Enter your email"
                       @bind-Value="_model.Email" />
        </div>
        <ValidationMessage For="@(() => _model.Email)" />
    </div>

    <div class="field">
        <label class="label">Password</label>
        <div class="control">
            <InputText class="input"
                       type="password"
                       placeholder="Enter your password"
                       @bind-Value="_model.Password" />
        </div>
        <ValidationMessage For="@(() => _model.Password)" />
    </div>

    <div class="field">
        <label class="checkbox">
            <InputCheckbox @bind-Value="_model.RememberMe" />
            Remember me
        </label>
    </div>

    <div class="field mt-5">
        <div class="control">
            <button type="submit"
                    class="button is-primary is-fullwidth">
                Login
            </button>
        </div>
    </div>

    @if (errors.Length > 0)
    {
        <ul>
            @foreach (var error in errors)
            {
                <li class="has-text-danger">@error</li>
            }
        </ul>
    }

    @if (!string.IsNullOrWhiteSpace(successMessage))
    {
        <p class="has-text-success">@successMessage</p>
    }

    <p class="has-text-centered mt-4">
        Don't have an account?
        <NavLink href="/register">
            Register
        </NavLink>
    </p>
</EditForm>

@code {
    private readonly LoginModel _model = new();

    private string[] errors = [];
    private string successMessage = "";

    private async Task HandleLoginAsync()
    {
        try
        {
            var request = new LoginRequestDto
            {
                Email = _model.Email,
                Password = _model.Password
            };

            var response =
                await Http.PostAsJsonAsync(
                    "api/auth/login",
                    request);

            if (response.IsSuccessStatusCode)
            {
                var loginResponse =
                    await response.Content
                        .ReadFromJsonAsync<LoginResponseDto>();

                if (loginResponse == null)
                {
                    successMessage = "";
                    errors = ["No login response received"];
                    return;
                }

                var token = loginResponse.Token;

                successMessage = "Login successful!";
                errors = [];
            }
            else
            {
                successMessage = "";
                errors = [$"Status code: {response.StatusCode}"];
            }
        }
        catch (Exception ex)
        {
            successMessage = "";
            errors = [ex.Message];
        }
    }

    private sealed class LoginModel
    {
        [Required]
        [EmailAddress]
        public string Email { get; set; } = string.Empty;

        [Required]
        public string Password { get; set; } = string.Empty;

        public bool RememberMe { get; set; }
    }
}