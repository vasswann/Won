@page "/login"
@rendermode InteractiveServer
@inject HttpClient Http
@using Won.Shared.Dtos
@using System.Net.Http.Json


<PageTitle>Login</PageTitle>

<div class="container">
    <h2>Login</h2>

    <div class="field">
        <label class="label">Email</label>
        <div class="control">
            <input class="input" type="email" @bind="email" placeholder="e.g. alexsmith@gmail.com">
        </div>
    </div>

    <div class="field">
        <label class="label">Password</label>
        <div class="control">
            <input class="input" type="password" @bind="password" placeholder="Password" />
        </div>
    </div>

    <div class="container button-container">
        <div class="control">
            <button class="button is-primary" @onclick="LoginUser">Login</button>
        </div>
    @if (errors.Length > 0)
        {
            <ul>
                @foreach (var error in errors)
                {
                    <li class="has-text-danger">@error</li>
                }
            </ul>
        }
    @if (!string.IsNullOrWhiteSpace(successMessage))
        {
            <p class="has-text-success">@successMessage</p>
        }

    </div>

</div>


@code {
    private string email = "";
    private string password = "";
    private string[] errors = [];
    private string successMessage = "";

    public async Task LoginUser()
    {       
        try
        {
            var request = new LoginRequestDto
            {
                Email = email,
                Password = password
            };

            var response =
                await Http.PostAsJsonAsync(
                    "api/auth/login",
                    request);

            if (response.IsSuccessStatusCode)
            {
                var loginResponse =
                   await response.Content
                   .ReadFromJsonAsync<LoginResponseDto>();

                successMessage = "Login successful!";

                var token = loginResponse?.Token;

            }
            else
            {
                errors = [$"Status code: {response.StatusCode}"];
            }
        }
        catch (Exception ex)
        {
            errors = [ex.ToString()];
        }
    }
}