@page "/activities/update/{ActivityId:int}"
@using Won.Shared.Dtos
@rendermode InteractiveServer

@inject Won.Web.Services.Activities.ActivityService ActivityService
@inject NavigationManager Navigation

<PageTitle>Edit Activity</PageTitle>

<h1 class="title is-2">Edit Activity</h1>

@if (_isLoading)
{
    <p>Loading activity...</p>
}
else
{
    <EditForm Model="UpdatedActivity" OnValidSubmit="UpdateActivity">

        <DataAnnotationsValidator />
        <ValidationSummary />

        <div class="box">

            <div class="field">
                <label class="label">Activity Name</label>
                <InputText class="input" @bind-Value="UpdatedActivity!.Name" />
            </div>

            <div class="field">
                <label class="label">Cost</label>
                <InputNumber class="input" @bind-Value="UpdatedActivity!.Cost" />
            </div>

            <div class="field">
                <label class="label">Group Size (Min)</label>
                <InputNumber class="input" @bind-Value="UpdatedActivity!.MinimumGroupSize" />
            </div>

            <div class="field">
                <label class="label">Group Size (Max)</label>
                <InputNumber class="input" @bind-Value="UpdatedActivity!.MaximumGroupSize" />
            </div>

            <div class="field">
                <label class="label">Date & Time</label>
                <InputDate class="input" @bind-Value="UpdatedActivity!.ActivityDateTime" />
            </div>

        </div>
        <div class="buttons">

            <button class="button is-warning" type="submit">
                Save Changes
            </button>

            <NavLink href="@($"/trips/{_tripId}")" class="button is-light">
                Cancel
            </NavLink>

        </div>

    </EditForm>
}

@code {
    [Parameter]
    public int ActivityId { get; set; }

    private int _tripId;
    private UpdateActivityDto? UpdatedActivity;
    private bool _isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        var activity = await ActivityService.GetActivityByIdAsync(ActivityId);

        if (activity == null)
        {
            _isLoading = false;
            return;
        }

        _tripId = activity.TripId;

        UpdatedActivity = new UpdateActivityDto
        {
            Name = activity.Name,
            Cost = activity.Cost,
            WeatherDependency = activity.WeatherDependency,
            EnergyIntensity = activity.EnergyIntensity,
            MinimumGroupSize = activity.MinimumGroupSize,
            MaximumGroupSize = activity.MaximumGroupSize,
            ActivityDateTime = activity.ActivityDateTime,
            TripId = activity.TripId
        };

        _isLoading = false;
    }

    private async Task UpdateActivity()
    {
        if (UpdatedActivity is null)
        {
            return;
        }

        var updated =
            await ActivityService.UpdateActivityAsync(ActivityId, UpdatedActivity);

        if (updated != null)
        {
            Navigation.NavigateTo($"/trips/{_tripId}");
        }
    }
}