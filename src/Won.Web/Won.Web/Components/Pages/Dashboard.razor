@page "/dashboard"
@using Won.Shared.Dtos
@using Won.Web.Components.Trips
@using Won.Web.Services.Trips
@inject TripsService TripsService

<PageTitle>Dashboard</PageTitle>



<h1 class="title is-2">Dashboard</h1>
<p class="subtitle is-6">
    Trips and activities overview
    </p>

@if (trips is null)
{
    <p>Loading...</p>
}
else
{
    <div class="is-flex is-justify-content-flex-end mb-4">
        <NavLink class="button is-primary mb-2" href="/trips/create">Add New Trip</NavLink>
    </div>

    <div class="columns is-desktop">
        <div class="column"><RecentTripsWidget Trips="trips" /></div>
        <div class="column"><UpcomingTripsComponent Trips="trips" /></div>
        <div class="column"><MostActiveTripWidget Trips="trips" /></div>
    </div>

}

@code {
    private List<TripListItemDto>? trips;

    protected override async Task OnInitializedAsync()
    {
        trips = await TripsService.GetTripsAsync();
    }
}