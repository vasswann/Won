@page "/dashboard"
@using Won.Shared.Dtos
@using Won.Web.Components.Trips
@using Won.Web.Services.Trips
@inject FakeTripService FakeTripService

<PageTitle>Dashboard</PageTitle>

<h1 class="title is-2">Dashboard</h1>

@if (trips is null)
{
    <p>Loading...</p>
}
else
{
    <RecentTripsWidget Trips="trips" />
}

@code {
    private List<TripListItemDto>? trips;

    protected override async Task OnInitializedAsync()
    {
        trips = await FakeTripService.GetTripsAsync();
    }
}