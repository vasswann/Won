@using Won.Web.Services.Trips
@using Won.Web.Services.Notifications

@inject TripsService TripsService
@inject NavigationManager Navigation
@inject NotificationService NotificationService

@if (!showConfirmation)
{
    <button class="button is-danger" @onclick="ShowConfirmation">
        Delete Trip
    </button>
}
else
{
    <div class="mt-3">
        <p>Are you sure you want to delete this trip?</p>

        <button class="button is-danger mr-2" @onclick="DeleteTrip">
            Yes, Delete
        </button>

        <button class="button is-light" @onclick="CancelDelete">
            Cancel
        </button>
    </div>
}

@code {

    [Parameter]
    public int TripId { get; set; }

    private bool showConfirmation = false;

    private void ShowConfirmation()
    {
        showConfirmation = true;
    }

    private void CancelDelete()
    {
        showConfirmation = false;
    }

    private async Task DeleteTrip()
    {
        try
        {
            var response =
                await TripsService.DeleteTripAsync(TripId);

            if (response.Success)
            {
                NotificationService.ShowSuccess(response.Message);
                Navigation.NavigateTo("/trips");
                return;
            }

            NotificationService.ShowError(response.Message);
        }
        catch
        {
            NotificationService.ShowError(
                "Something went wrong while deleting the trip.");
        }
    }
}