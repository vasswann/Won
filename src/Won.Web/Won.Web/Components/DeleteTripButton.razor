@using Won.Web.Services.Trips
@inject TripsService TripsService
@inject NavigationManager Navigation

@if (!showConfirmation)
{
    <button class="button is-danger mt-3" @onclick="ShowConfirmation">
        Delete Trip
    </button>
}
else
{
    <div class="mt-3">
        <p>Are you sure you want to delete this trip?</p>

        <button class="button is-danger mr-2" @onclick="DeleteTrip">
            Yes, Delete
        </button>

        <button class="button is-light" @onclick="CancelDelete">
            Cancel
        </button>
    </div>
}

@code {

    [Parameter]
    public int TripId { get; set; }

    private bool showConfirmation = false;

    private void ShowConfirmation()
    {
        showConfirmation = true;
    }

    private void CancelDelete()
    {
        showConfirmation = false;
    }

    private async Task DeleteTrip()
    {
        var success = await TripsService.DeleteTripAsync(TripId);

        if (success)
        {
            Navigation.NavigateTo("/trips");
        }
    }
}