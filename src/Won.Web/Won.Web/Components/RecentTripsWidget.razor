@using Won.Shared.Dtos
@using Won.Web.Components.Trips
@inject NavigationManager Navigation

<div class="box recent-trips-widget">
    <div class="is-flex is-justify-content-space-between is-align-items-center mb-2">
        <h3 class="title is-4 mb-0">Recent Trips</h3>

        <a class="is-size-7" href="/trips">View all</a>
    </div>

    @if (RecentTrips.Count == 0)
    {
        <p class="has-text-grey is-size-7">No previous trips found.</p>
    }
    else
    {
        @foreach (var trip in RecentTrips)
        {
            <TripCard Trip="trip" />
        }
    }
</div>

@code {
    [Parameter]
    public List<TripListItemDto> Trips { get; set; } = [];

    private List<TripListItemDto> RecentTrips =>
        Trips.Where(t => t.EndDate < DateTime.UtcNow)
                .OrderByDescending(t => t.StartDate)
                .Take(5)
                .ToList();
    
    private void GoToTrips()
    {
        Navigation.NavigateTo("/trips");
    }
}