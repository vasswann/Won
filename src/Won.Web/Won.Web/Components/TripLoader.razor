@using System.Net.Http
@using System.Net.Http.Json
@using Won.Shared.Models
@rendermode InteractiveServer

@inject HttpClient Http 
@* Probably need to comment the about out - leaving in place for line 41 for now *@


@if (_tripById is null && !_hasError)
{
    <div><p><em>Loading...</em></p></div>
    <div class="loader-wrapper">
        <div class="loader is-loading"></div>
    </div>
}
else if (_hasError)
{
    <div class="notification">
        <strong>Oops!</strong> We can't load details for that trip right now.
    </div>
}
else if (_tripById is not null)
{
    @* <GetTripCard trip="_tripById" /> *@
    <GetTripCard ThisTrip="MyTrip" />
}



@code {
    public int id { get; set; }
    private Trip? _tripById;
    private Trip? MyTrip;
    public int Id = 4;
    // public int Trip.TripId = 4;
    private bool _hasError = false;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            Console.WriteLine("Checkpoint: ");
            _hasError = false;
            MyTrip = TestTrips.FirstOrDefault(Trip => Trip.TripId == Id);
            _tripById = await Http.GetFromJsonAsync<Trip>($"trips/{id}"); // "/trips/{Id:int}"
        }
        catch (Exception e)
        {
            _hasError = true;
            Console.WriteLine($"Error loading trips data: {e.Message}");
        }
    }


