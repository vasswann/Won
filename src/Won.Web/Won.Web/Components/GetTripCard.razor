@using Won.Shared.Models

@if(ThisTrip == null)
{
    <p>Loading...</p>
}
else
{
    <div class="ThisTrip-summary">
        <div class="line"></div>

        <h2 class="ThisTrip-name">@ThisTrip.Name</h2>
        <ul class="ThisTrip-info-list">
            <li class="ThisTrip-start-date"><strong>Start Date:</strong> @ThisTrip.StartDate.ToString("dd/MM/yyyy")</li>
            <li class="ThisTrip-end-date"><strong>End Date:</strong> @ThisTrip.EndDate.ToString("dd/MM/yyyy")</li>
            <li class="ThisTrip-location"><strong>Location: </strong> @ThisTrip.Location</li>
            <li class="ThisTrip-details"><strong>Details: </strong> @ThisTrip.Details</li>
            <li class="ThisTrip-budget"><strong>Budget: </strong> @ThisTrip.Budget.ToString()</li>
            <li class="ThisTrip-group-size"><strong>Group Size: </strong> @ThisTrip.GroupSize.ToString()</li>
        </ul>
    </div>
}

@code {
    [Parameter]
    public Trip ThisTrip { get; set; }
}
