@using Won.Shared.Dtos

<NavLink href="@($"/trips/{Trip.TripId}")" class="has-text-dark">
    <div class="box has-background-white">

        <h2 class="title is-4 mb-3">
            @Trip.Name
        </h2>

        <hr class="my-4" />

        <p class="mb-3">
            <strong>Location:</strong> @Trip.Location
        </p>

        <p>
            <strong>Dates:</strong>
            @Trip.StartDate.ToString("dd MMM yyyy") - @Trip.EndDate.ToString("dd MMM yyyy")
        </p>
    </div>
</NavLink>

@code {
    [Parameter]
    public TripListItemDto Trip { get; set; } = default!;
}