@using Won.Shared.Dtos

<NavLink href="@($"/trips/{Trip.TripId}")" class="card">
    <div class="card-content">
        <p class="title is-4">@Trip.Name</p>
        <div class="trip-data">
            <p class="subtitle is-6">
                <strong class="has-text-inherit">Location:</strong> @Trip.Location
            </p>

            <div class="content">
                <p>
                    <strong class="has-text-inherit">Dates:</strong>
                    @Trip.StartDate.ToString("dd MMM yyyy") - @Trip.EndDate.ToString("dd MMM yyyy")
                </p>
            </div>
        </div>
    </div>
</NavLink>

@code {
    [Parameter]
    public TripListItemDto Trip { get; set; } = default!;
}