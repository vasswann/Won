@using Won.Shared.Models
@inject NavigationManager Navigation

<NavLink @onclick="GoToEdit">Edit Trip</NavLink>

@code {
    [Parameter]
    public required Trip ThisTrip { get; set; }

    private void GoToEdit()
    {
        if (ThisTrip is null)
        {
            Console.WriteLine("ThisTrip is null");
            return;
        }
        Navigation.NavigateTo($"/trips/update/{ThisTrip.TripId}");
    }
}
