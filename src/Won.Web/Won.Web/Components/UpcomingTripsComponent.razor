@using Won.Shared.Dtos
@using Won.Web.Components.Trips
@inject NavigationManager Navigation

<div class="box dashboard-container">
   
    <h3 class="title is-4 mb-5">Upcoming Trips</h3>

    @if (UpcomingTrips.Count == 0)
    {
        <p class="has-text-grey is-size-7">No upcoming trips found.</p>
    }
    else
    {
        @foreach (var trip in UpcomingTrips)
        {
            <div class="trip-item">
                <TripCard Trip="trip" />
            </div>
        }
    }
</div>

@code {
    [Parameter]
    public List<TripListItemDto> Trips { get; set; } = [];

    private List<TripListItemDto> UpcomingTrips =>
        Trips.Where(t => t.StartDate > DateTime.UtcNow)
                .OrderBy(t => t.StartDate)
                .Take(5)
                .ToList();
    
    private void GoToTrips()
    {
        Navigation.NavigateTo("/trips");
    }
}